# ==============================================================================
# MULTIMODAL AI-ENABLED DIAGNOSTIC LAB CONFIGURATION
# (All environment variables are intentionally left blank as requested)
# Fill these in whenever you are ready to connect live cloud services.
# When left blank, the application operates in Intelligent Zero-Config Simulation Mode!
# ==============================================================================

# --- LLM & Multimodal AI Providers ---
# Google Gemini API Key (for Multimodal Vision & Reasoning)
GEMINI_API_KEY=

# OpenAI API Key (for GPT-4o / Realtime Voice Agent)
OPENAI_API_KEY=

# --- Voice & Speech Services ---
# Deepgram Speech-to-Text API Key
DEEPGRAM_API_KEY=

# ElevenLabs High-Fidelity Human-Like Text-to-Speech API Key
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Telephony & SIP Webhook Integration ---
# Twilio Voice credentials (for inbound real phone calls)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# LiveKit Cloud or Self-Hosted WebRTC/SIP credentials
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Database & Storage ---
# Database Connection URL (e.g. postgresql://user:password@localhost:5432/medilab)
# If blank, defaults to high-performance local SQLite (diagnostic_lab.db)
DATABASE_URL=

# --- Server Settings ---
HOST=0.0.0.0
PORT=8000
DEBUG=true
