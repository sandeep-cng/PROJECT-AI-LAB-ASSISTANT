# ==============================================================================
# MULTIMODAL AI-ENABLED DIAGNOSTIC LAB CONFIGURATION
# Fill these in whenever you are ready to connect live cloud services.
# When left blank, the application operates in Intelligent Zero-Config Simulation Mode!
# ==============================================================================

# --- Chat & Telephony Care Coordinator Persona ---
AGENT_NAME=Riya
AGENT_PHONE_NUMBER=+918043888802
DEFAULT_COUNTRY_CODE=+91
EMPATHY_MODE_ENABLED=true
# Ambiguity detection sensitivity (lower threshold = more strict human escalation)
AMBIGUITY_THRESHOLD=0.35
# Direct Transfer line to Real Human Medical Officer / Clinical Supervisor Desk (Riya Desk)
HUMAN_ASSISTANT_PHONE_NUMBER=+918043888802
DUTY_DOCTOR_PHONE_NUMBER=+918043888803

# --- Automated Booking Notifications: GMAIL (SMTP / Email) ---
# Gmail SMTP Host (default: smtp.gmail.com)
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
# Clinic Gmail Address (e.g. your_clinic@gmail.com)
GMAIL_SENDER_EMAIL=
# Google 16-character App Password (generated in Google Account -> Security -> App Passwords)
GMAIL_APP_PASSWORD=
GMAIL_SENDER_NAME=Apex Family Diagnostic Lab

# --- Automated Booking Notifications: WHATSAPP ---
# WhatsApp Provider: 'twilio', 'meta', 'exotel', or 'simulation'
WHATSAPP_PROVIDER=twilio
# Twilio WhatsApp Sender Number (e.g. whatsapp:+14155238886 for Twilio sandbox)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Meta Cloud WhatsApp API Token & Phone ID (optional alternative)
META_WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_KEY=

# --- LLM & Multimodal AI Providers ---
# Google Gemini API Key (for Multimodal Vision, Reasoning, & Policy Embeddings)
GEMINI_API_KEY=

# OpenAI API Key (for GPT-4o / Realtime Voice Agent / Embeddings)
OPENAI_API_KEY=

# --- Voice, Speech & Barge-in Controls ---
# Enable immediate cut-off when the caller/user begins speaking (Barge-In)
BARGE_IN_ENABLED=true
INTERRUPT_ON_USER_SPEECH=true
# Voice Activity Detection (VAD) energy sensitivity (0.01 - 0.10)
VAD_SENSITIVITY=0.04

# Deepgram Speech-to-Text API Key
DEEPGRAM_API_KEY=

# ElevenLabs High-Fidelity Human-Like Text-to-Speech API Key
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Cloud Telephony: Exotel (India / Asia Telephony) ---
# Exotel Account SID / Customer SID (e.g. your_exotel_account_sid)
EXOTEL_ACCOUNT_SID=
# Exotel API Key
EXOTEL_API_KEY=
# Exotel API Token
EXOTEL_API_TOKEN=
# Exotel Subdomain (defaults to api.exotel.com or api.in.exotel.com)
EXOTEL_SUBDOMAIN=api.exotel.com
# Exotel ExoPhone / Virtual Caller ID (e.g. 080XXXXXXXX or +91XXXXXXXXXX)
EXOTEL_VIRTUAL_NUMBER=
# Exotel Applet / App ID for Voice Call Flow
EXOTEL_APP_ID=
# Exotel Webhook Secret (optional, for signature verification)
EXOTEL_WEBHOOK_SECRET=

# --- Cloud Telephony: Twilio & WebRTC ---
# Twilio Voice credentials (for international inbound real phone calls)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# LiveKit Cloud or Self-Hosted WebRTC/SIP credentials
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Relational Database: PostgreSQL & SQLite ---
# Complete Database Connection URL (e.g. postgresql://postgres:postgres@localhost:5432/diagnostic_lab)
# If blank, the system automatically builds from individual POSTGRES_* vars below,
# or seamlessly falls back to high-performance local SQLite (diagnostic_lab.db).
DATABASE_URL=

# Individual PostgreSQL Configuration Parameters:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=diagnostic_lab
POSTGRES_SSLMODE=prefer

# --- Vector Database & RAG Configuration ---
# Vector DB Provider: 'memory' (zero-config local), 'pgvector' (PostgreSQL), 'chroma', 'pinecone', 'qdrant'
VECTOR_DB_TYPE=memory

# Embedding Provider: 'gemini', 'openai', or 'local_bm25'
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004
VECTOR_SEARCH_TOP_K=3

# 1. PostgreSQL pgvector Settings
PGVECTOR_ENABLED=false
PGVECTOR_TABLE=diagnostic_policy_vectors

# 2. ChromaDB Settings
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_HOST=
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=diagnostic_policies

# 3. Pinecone Vector DB Settings
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=diagnostic-lab-rag

# 4. Qdrant Vector DB Settings
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=diagnostic_policies

# --- Server Settings ---
HOST=0.0.0.0
PORT=8000
DEBUG=true
